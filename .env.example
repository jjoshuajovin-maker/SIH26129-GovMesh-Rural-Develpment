# Environment Configuration Template - GovMesh Department 3 (Rural Development & Panchayat Raj)
# Copy to .env for local runtime settings

PORT=5003
NODE_ENV=production

# Cloud PostgreSQL Connection String (e.g. Neon / Supabase / Render / Vercel Postgres)
# Leave empty to run with built-in persistent pre-seeded datastore
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# JWT & Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
SESSION_TIMEOUT_MINUTES=15

# GovMesh Interoperability Configuration
RURAL_API_BASE_URL=https://sih-26129-gov-mesh-rural-develpment.vercel.app
GOVMESH_CORE_URL=https://sih-26129-gov-mesh-citizen.vercel.app
