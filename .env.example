# Environment Configuration Template - GovMesh Department 3 Demo
# Copy this file to .env for local runtime settings

PORT=5000
NODE_ENV=development

# Database Configuration (SQLite File Path)
DATABASE_FILE=./data_store.json

# Simulated Legacy SFTP Credentials (DEMO ONLY)
SFTP_HOST=demo-sftp.internal
SFTP_PORT=22
SFTP_USERNAME=govmesh_adapter
SFTP_KEY_PATH=./keys/sftp_rsa_demo.key

# Authentication & Session Settings
JWT_SECRET=demo_govmesh_dept3_jwt_secret_key_change_in_production
SESSION_TIMEOUT_MINUTES=15
