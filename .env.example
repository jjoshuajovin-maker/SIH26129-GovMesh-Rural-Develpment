# Environment Configuration Template - GovMesh Department 3
# Copy to .env for local runtime settings

PORT=5000
NODE_ENV=production

# Cloud PostgreSQL Connection String (Neon / Supabase / Vercel Postgres)
# Leave empty to run with persistent pre-seeded in-memory/JSON data
DATABASE_URL=postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/govmesh_dept3?sslmode=require

# JWT & Authentication Secret
JWT_SECRET=demo_govmesh_dept3_jwt_secret_key_change_in_production
SESSION_TIMEOUT_MINUTES=15
